# --- Database ---
# Local demo default (SQLite, zero setup): sqlite:///./recoverai.db
# Production: postgresql://user:password@host:5432/recoverai
DATABASE_URL=sqlite:///./recoverai.db

# --- AI ---
# Optional. If unset, RecoverAI uses its deterministic rule-based diagnosis
# engine (app/agents/ai_service.py), which is fully offline and demo-safe.
# Setting this routes diagnosis through a real LLM call.
LLM_API_KEY=

# --- Payment provider (live integration mode) ---
# Leave both unset to run entirely on the built-in MockPaymentProvider.
# Set both to route real actions (Payment Links, payment status checks)
# through Razorpay's actual REST API — get test-mode keys free from your
# Razorpay Dashboard > Settings > API Keys (test mode requires no live
# business verification). Test-mode keys are safe: no real money moves.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_PROVIDER_SECRET=
# Set to require HMAC-SHA256-signed webhooks (X-Razorpay-Signature or
# X-Webhook-Signature header — both accepted). This should match the
# "Secret" you configure when adding a webhook in the Razorpay Dashboard.
# Leave unset for demo mode (no signature required).
PAYMENT_WEBHOOK_SECRET=

# --- App auth ---
# Set to require X-API-Key on mutating endpoints (case actions, policy
# edits, promise-to-pay, demo reset) for MACHINE callers (a merchant's own
# backend). Leave unset for demo mode (open). This does not gate the
# dashboard itself — see DASHBOARD_PASSWORD below for that.
API_KEY=

# Set to require a person to log in before the dashboard loads (a real
# password -> session-token exchange at /api/auth/login, see app/auth.py —
# not the same mechanism as API_KEY above, which only a machine can hold).
# Once set, every /api/ route requires either a valid session or a valid
# X-API-Key, not just the mutating ones. Leave unset for demo mode (open).
DASHBOARD_PASSWORD=
# Signs session tokens. If unset, a random key is generated per process —
# fine for a single instance, but every instance in a multi-instance
# deployment must share the same SESSION_SECRET or they'll reject each
# other's tokens. Set explicitly for anything beyond one process.
SESSION_SECRET=

# --- Communication providers (live integration mode) ---
# Email via SendGrid (https://app.sendgrid.com/settings/api_keys). Both
# required to go live; leave either unset to keep email on the mock provider.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# WhatsApp via Meta's official WhatsApp Cloud API (checked first — free
# tier, 1,000 conversations/month, no card required). Get both from
# developers.facebook.com: create an app, add the WhatsApp product, and
# the API Setup panel gives you a temporary access token + test phone
# number ID immediately, no business verification needed for testing.
# Both required to go live; leave either unset to fall through to Twilio.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp via Twilio (https://console.twilio.com — Account SID + Auth Token
# on the console dashboard; WHATSAPP_FROM is your Twilio WhatsApp sender,
# e.g. the sandbox number "whatsapp:+14155238886" or an approved production
# sender). All three required to go live. Used only if META_WHATSAPP_TOKEN
# is unset. Note: Twilio Trial accounts cannot send freeform sandbox
# messages via the API (requires a Content Template, which needs a paid
# account) — Meta's Cloud API above doesn't have this restriction.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:8000
